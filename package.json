{
  "name": "carvin-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "echo '📦 Usa pnpm deploy para provisionamiento inicial. El seed solo corre sobre BD vacía.'",
    "db:backup": "tsx src/db/backup.ts create",
    "db:restore": "tsx src/db/backup.ts restore",
    "release:client": "node scripts/release-client.js",
    "update:release": "node scripts/update-release.js",
    "typecheck": "npx tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "deploy": "node scripts/deploy.js",
    "init-client": "node scripts/setup-client.js",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report"
  },
  "pnpmOvercomesWebpack": true,
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "15.0.3",
