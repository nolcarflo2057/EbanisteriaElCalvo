# ============================================================
# CARVIN LANDING - Variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y completa los valores.
# Las variables marcadas como OPCIONALES pueden quedar vacias.
# ============================================================

# --- App ---
APP_NAME=VIVALDI
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Base de datos (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require"

# --- Autenticacion (Better Auth) ---
BETTER_AUTH_SECRET=genera_un_token_seguro_de_32_caracteres_min
BETTER_AUTH_URL=http://localhost:3000

# --- Email transaccional (Resend SMTP) ---
# El destino de las notificaciones es el contactEmail que el cliente
# configura en Ajustes. From = EMAIL_FROM (remitente verificado).
# Pega tu API key de Resend en SMTP_PASS (empieza con re_).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# --- Subida de imagenes (UploadThing) ---
UPLOADTHING_TOKEN=

# --- Notificaciones en tiempo real (Pusher) - OPCIONAL ---
# Si se dejan vacias, el panel usa polling 5s (sin terceros).
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_APP_ID=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# --- Cache / Redis (Upstash) - OPCIONAL ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- IA para chatbot avanzado (OpenRouter) - OPCIONAL ---
OPEN_ROUTER_KEY=

# --- Seed: admin por defecto (solo desarrollo) ---
SEED_ADMIN_EMAIL="admin@admin.com"
SEED_ADMIN_PASSWORD="Admin123*"

# --- Single-tenant: el proxy reescribe "/" -> "/<slug>/..." ---
NEXT_PUBLIC_SINGLE_TENANT=true
NEXT_PUBLIC_TENANT_SLUG=ebanisteria-el-calvo
